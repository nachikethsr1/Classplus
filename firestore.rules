rules_version = '2';

// ============================================================
// FIRESTORE SECURITY RULES
// District Training Institute, Bengaluru City
// ------------------------------------------------------------
// This file is the real access control for the portal.
// Anything enforced only in JavaScript can be bypassed by anyone
// who opens the browser console, so every rule below is written
// on the assumption that the client is hostile.
//
// DEPLOY
//   firebase deploy --only firestore:rules
//   (or paste this file into Firebase Console -> Firestore ->
//    Rules -> Publish)
//
// ADMIN
//   Admin is granted by an EMAIL ALLOWLIST evaluated here, on the
//   server side. Replace the address below with your mother's
//   Google account, and keep window.ADMIN_EMAILS in
//   js/firebase-config.js in sync (that copy only controls which
//   menus appear; this copy is what actually grants access).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // The single authorized administrator.
    // Change this string, then redeploy the rules.
    function adminEmail() {
      return 'savithakh80@gmail.com';
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == adminEmail();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Has this account been approved by the admin?
    // Reads the caller's own profile document.
    function myStatus() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status;
    }

    function isApproved() {
      return isSignedIn() && myStatus() == 'approved';
    }

    // Fields a student is never allowed to write on their own profile.
    function protectedProfileFields() {
      return [
        'status', 'role', 'verifiedAt', 'verifiedBy',
        'createdAt', 'uid', 'marks', 'results'
      ];
    }

    // ---------- server-side marking ----------
    //
    // These rules mark the paper. Not the browser.
    //
    // Security Rules are evaluated by Firestore itself, and get() inside a
    // rule reads a document with full privileges — the caller's own read
    // permissions do not apply. So a rule can open the private answer key
    // that the student cannot, compare it with what they handed in, and
    // refuse any score that does not match. That is a genuine server-side
    // marking step on the Spark (free) plan, with no Cloud Function.
    //
    // Rules have no loops, so the key cannot be summed over a map. Instead
    // both sides are expressed as a flat list of tokens, one token per MARK:
    //
    //   question q3, correct option 2, worth 2 marks
    //     -> key tokens    "q3:2#1", "q3:2#2"
    //   the student picked option 0
    //     -> answer tokens "q3:0#1", "q3:0#2"
    //
    // marks earned = how many of the student's tokens appear in the key,
    // which is a set intersection, which rules CAN do. Flooding the list
    // with every option is useless: the token count is capped at the total
    // marks available, so extra guesses for one question can only crowd out
    // the others.
    //
    // The tokens are written once, at create, and frozen there. The key only
    // becomes readable to the student AFTER that document exists (see
    // trainingKeys below), so at the moment they commit to an answer they
    // cannot know whether it is right.

    function keyDoc(trainingId) {
      return get(/databases/$(database)/documents/trainingKeys/$(trainingId)).data;
    }

    // The one submission id this caller may use for this training.
    // Deterministic, so the key-release rule below can find it, and so a
    // second attempt is impossible.
    function mySubmissionId(trainingId) {
      return request.auth.uid + '_' + trainingId;
    }

    // Marks earned = |student tokens ∩ key tokens|.
    function earnedMarks(tokens, trainingId) {
      return tokens.toSet().intersection(keyDoc(trainingId).tokens.toSet()).size();
    }

    // Everything a student is not allowed to assert about their own result.
    function scoreFields() {
      return ['marksObtained', 'totalMarks', 'percentage', 'passStatus',
              'correctCount', 'wrongCount', 'passingPercent', 'scoredAt'];
    }

    function carriesNoScore(data) {
      return !data.keys().hasAny(scoreFields());
    }

    // The score being written must be the score the key produces.
    // percentage and passStatus are derived exactly the way computeResult()
    // in index.html derives them, so the number on screen and the number in
    // the database are the same number.
    function scoreIsHonest(trainingId, tokens) {
      let k = keyDoc(trainingId);
      let earned = earnedMarks(tokens, trainingId);
      let pct = math.round(earned * 100.0 / k.totalMarks);
      return k.totalMarks > 0
        && request.resource.data.marksObtained == earned
        && request.resource.data.totalMarks == k.totalMarks
        && request.resource.data.percentage == pct
        && request.resource.data.passStatus == (pct >= k.passing);
    }

    // The submission a certificate claims to be based on.
    function submissionData(submissionId) {
      return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
    }

    // A certificate is only honest if it passed and copies that
    // submission's marks exactly. Used by both issuing paths below.
    function certificateMatchesSubmission(submissionId) {
      let sub = submissionData(submissionId);
      return sub.passStatus == true
        && request.resource.data.marks == sub.marksObtained
        && request.resource.data.total == sub.totalMarks
        && request.resource.data.pct == sub.percentage;
    }

    // KGID appears on the certificate, so it is frozen once an admin has
    // approved the account: before approval a student may fix a typo,
    // afterwards only an admin may change it.
    function studentMayUpdateProfile() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      return touched.hasAny(protectedProfileFields()) == false
             && (resource.data.status == 'approved'
                   ? touched.hasAny(['kgid', 'officialName']) == false
                   : true);
    }

    // ---------- students ----------
    // students/{uid}
    match /students/{uid} {
      // A student may read only their own profile.
      // The admin may read every profile.
      allow read: if isSelf(uid) || isAdmin();

      // First sign-in creates the profile. Approval status can only
      // start as 'pending' — nobody can register themselves as approved.
      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'student';

      // A student may correct their own details, but running an
      // update that touches status/role/verification is refused.
      allow update: if isSelf(uid) && studentMayUpdateProfile();

      // Only the admin may approve, reject, disable or delete.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- training answer keys ----------
    // trainingKeys/{trainingId}  { key: { questionId: optionIndex } }
    //
    // The whole point of this collection is that a student cannot read it.
    // Score-bearing answer keys belong here, never on the training document.
    //
    // NOTE: while the app still marks papers in the browser (SCORING.mode
    // === 'client' in index.html) the key has to remain readable, so a
    // mirror is kept on trainings/{id}. Adopted together with the scoring
    // Cloud Function, this collection is what makes the exam closed-book.
    match /trainingKeys/{trainingId} {
      // The key is released to a student ONLY after their own submission
      // for this training exists. Before that moment the paper is closed:
      // nothing the browser can reach holds the correct answers.
      //
      // After that moment the key is harmless. The answers are already
      // written and frozen, and the marks are recomputed from them by
      // scoreIsHonest() below — so releasing the key here is what lets the
      // result appear instantly, with no server and no waiting.
      allow read: if isAdmin()
        || (isApproved()
            && exists(/databases/$(database)/documents/submissions/$(mySubmissionId(trainingId))));

      allow write: if isAdmin();
    }

    // ---------- trainings ----------
    // trainings/{trainingId}
    match /trainings/{trainingId} {
      // Students see published trainings only; drafts are invisible.
      // The admin sees everything.
      //
      // ONE CLAUSE ON PURPOSE. Firestore evaluates rules as a pre-filter
      // on a list query: the query is refused outright unless its own
      // constraints prove every condition the rule puts on resource.data.
      // The student loader runs
      //     where('published','==',true)
      // so that is exactly what this rule may require. An extra
      //     resource.data.archived != true
      // here refused that query with permission-denied and left every
      // student looking at an empty portal — confirmed against the
      // emulator, see tests/emulator/suites/02-trainings.js (T08).
      //
      // Archived trainings are still not visible to students:
      //   - 'archive-training' in index.html writes
      //     { archived: true, published: false }, so archiving already
      //     takes the training out of this rule's reach, and
      //   - loadTrainingsForStudent() drops archived === true client-side
      //     for the hand-edited case where a document is both published
      //     and archived.
      allow read: if isAdmin()
        || (isApproved() && resource.data.published == true);

      // Nobody but the admin can create or change a training, which
      // is what keeps question text safe.
      //
      // The answer key must never reappear on this document: every
      // approved student can read it, so a key here is a key in the
      // browser console. Keys live in trainingKeys/{id} and nowhere else.
      allow create, update: if isAdmin()
        && !('answerKey' in request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------- submissions ----------
    // submissions/{submissionId}
    match /submissions/{submissionId} {
      // A student reads only their own attempts. The admin reads all.
      allow read: if isSelf(resource.data.studentUid) || isAdmin();

      // Handing the paper in. The student writes their answers and NOTHING
      // about how well they did: a create carrying marksObtained,
      // passStatus or any other score field is refused outright.
      //
      // The id is fixed to <uid>_<trainingId>. That makes a second attempt
      // impossible — a write to an existing document is an update, and the
      // update rule below only lets the score be filled in — and it gives
      // the trainingKeys rule a document it can look up.
      allow create: if isApproved()
        && request.resource.data.studentUid == request.auth.uid
        && submissionId == mySubmissionId(request.resource.data.trainingId)
        && request.resource.data.keys().hasAll([
             'studentUid', 'trainingId', 'officialNameSnapshot',
             'kgidSnapshot', 'feedbackResponses', 'assessmentAnswers',
             'answerTokens', 'submittedAt'
           ])
        && carriesNoScore(request.resource.data)
        && request.resource.data.answerTokens is list
        && request.resource.data.answerTokens.size() ==
           request.resource.data.answerTokens.toSet().size()
        && request.resource.data.answerTokens.size() <=
           keyDoc(request.resource.data.trainingId).totalMarks
        && get(/databases/$(database)/documents/trainings/$(request.resource.data.trainingId)).data.published == true;

      // Marking. The ONLY update anyone may make is to fill the score in,
      // and only with the score the answer key actually produces: the rule
      // recomputes it from the frozen answerTokens. Everything else about
      // the document — the answers above all — stays immutable.
      //
      // The student does this once, immediately after handing in, which is
      // what produces the instant result screen. The admin may re-run it,
      // which is the repair path if a key was wrong and had to be fixed.
      allow update: if (isAdmin() || isSelf(resource.data.studentUid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(scoreFields())
        && (isAdmin() || carriesNoScore(resource.data))
        // a document written before answer tokens existed cannot be marked
        // by the rules, so it cannot be scored from the browser at all
        && 'answerTokens' in resource.data
        && scoreIsHonest(resource.data.trainingId, resource.data.answerTokens);

      allow delete: if isAdmin();
    }

    // ---------- certificates ----------
    // certificates/{certificateId}
    // The issued certificate register. One document per certificate.
    match /certificates/{certificateId} {
      // A student sees only their own certificates; the admin sees all.
      allow read: if isSelf(resource.data.studentUid) || isAdmin();

      // A certificate may only ever be created on top of a real, passed
      // submission whose scores it copies verbatim. That blocks a
      // fabricated certificate for a failed or missing attempt, and it
      // blocks inflated marks, for the student AND for the admin.
      //
      // Two issuers:
      //   - the student, for their own passed submission (the browser
      //     still writes this today), and
      //   - the admin, for the student who owns that submission. The
      //     admin branch used to be missing, so an administrator could
      //     not issue or re-issue a certificate at all — the only way to
      //     replace a provisional number is delete + re-issue, and that
      //     was impossible. Confirmed against the emulator:
      //     tests/emulator/suites/05-certificates.js (C25).
      //
      // NOTE: submissions are still written by the browser until the
      // scoring Cloud Function lands (see FIREBASE_SETUP.md). Once it
      // does, both collections can be closed to students entirely.
      allow create: if request.resource.data.number is string
        && request.resource.data.number != ''
        && certificateMatchesSubmission(request.resource.data.submissionId)
        && (
             (isSelf(request.resource.data.studentUid)
               && submissionData(request.resource.data.submissionId).studentUid == request.auth.uid)
             || (isAdmin()
               && submissionData(request.resource.data.submissionId).studentUid == request.resource.data.studentUid)
           );

      // Certificates are a permanent record: nobody rewrites them after
      // issue. Only the admin can remove one.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- certificate design ----------
    // certificateDesigns/current  (single active design)
    match /certificateDesigns/{docId} {
      allow read: if isSignedIn();      // students need the layout to render
      allow write: if isAdmin();        // only the admin edits it
    }

    // ---------- settings ----------
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- counters ----------
    // Used for the certificate serial number. Written only through
    // the admin-side logic; students never touch it.
    match /counters/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- deny everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
